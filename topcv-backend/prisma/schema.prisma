generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobLevel {
  NHAN_VIEN
  TRUONG_NHOM
  TRUONG_PHO_PHONG
  QUAN_LY_GIAM_SAT
  TRUONG_CHI_NHANH
  PHO_GIAM_DOC
  GIAM_DOC
  THUC_TAP_SINH
}

enum WorkingType {
  TOAN_THOI_GIAN
  BAN_THOI_GIAN
  FREELANCE
  THUC_TAP
  REMOTE
}

enum WorkingDays {
  MON_FRI       // Thứ 2 - Thứ 6
  MON_SAT       // Thứ 2 - Thứ 7
  MON_SUN       // Thứ 2 - Chủ nhật
  FLEXIBLE      // Linh hoạt
  CUSTOM        // Tùy chỉnh (xem workingDaysNote)
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
}

enum EmailTemplateType {
  REJECTION
  INTERVIEW_INVITE
  OFFER_LETTER
}

enum ConnectStatus {
  PENDING
  CONNECTED
  REJECTED
  SKIPPED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  phone            String?  @unique
  role             Role     @default(CANDIDATE)
  isVerified       Boolean  @default(false) @map("is_verified")
  isActive         Boolean  @default(true) @map("is_active")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  provider         String   @default("local")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  plan             String    @default("FREE")
  planExpiresAt    DateTime? @map("plan_expires_at")
  resumes          Resume[]
  coverLetters     CoverLetter[]
  payments         Payment[]
  companyFollows   CompanyFollow[]
  companyReviews   CompanyReview[]
  applications     Application[]
  savedJobs        SavedJob[]
  fcmToken         String?   @map("fcm_token")

  conversationsAsCandidate Conversation[]             @relation("CandidateConversations")
  sentMessages             Message[]                   @relation("SentMessages")
  connectsAsCandidate      EmployerCandidateConnect[]  @relation("ConnectCandidate")

  @@map("users")
}

model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  fullName            String   @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  isLookingForJob     Boolean  @default(false) @map("is_looking_for_job")
  allowEmployerSearch Boolean  @default(true) @map("allow_employer_search")
  jobPreferences      Json?    @map("job_preferences")
  defaultCvId         String?   @map("default_cv_id")
  gender              String?
  dob                 DateTime? @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCv Resume? @relation("CandidateDefaultCv", fields: [defaultCvId], references: [id], onDelete: SetNull)

  @@map("candidate_profiles")
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  logoUrl     String?  @map("logo_url")
  companySize String?  @map("company_size")
  industryId  Int?     @map("industry_id")
  industryIds Json?    @map("industry_ids")
  website     String?
  address     String?
  description String?
  taxCode     String?  @map("tax_code")
  slug        String?  @unique
  createdAt   DateTime @default(now()) @map("created_at")

  emailNotificationEnabled Boolean @default(false) @map("email_notification_enabled")

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry       Industry?                  @relation(fields: [industryId], references: [id])
  jobs           Job[]
  followers      CompanyFollow[]
  reviews        CompanyReview[]
  emailTemplates EmailTemplate[]
  conversations  Conversation[]
  connects       EmployerCandidateConnect[]

  @@map("employer_profiles")
}

model CompanyFollow {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  employerProfileId String   @map("employer_profile_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, employerProfileId])
  @@map("company_follows")
}

model CompanyReview {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  employerProfileId String   @map("employer_profile_id")
  rating            Int
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, employerProfileId])
  @@map("company_reviews")
}

model Industry {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  employerProfiles EmployerProfile[]
  jobs             Job[]

  @@map("industries")
}

model JobPosition {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  jobs Job[]

  @@map("job_positions")
}

model Job {
  id              String       @id @default(uuid())
  employerId      String       @map("employer_id")
  title           String
  slug            String?      @unique @map("slug")
  description     String
  salaryMin       Int?         @map("salary_min")
  salaryMax       Int?         @map("salary_max")
  salaryType      String       @default("range") @map("salary_type")
  jobType         String?      @map("job_type")
  experience      String?
  level           JobLevel?
  workingType     WorkingType? @map("working_type")
  workingDays     WorkingDays? @map("working_days")
  workingDaysNote String?      @map("working_days_note")
  quantity        Int          @default(1)
  deadline        DateTime?
  isActive        Boolean      @default(true) @map("is_active")
  industryId      Int?         @map("industry_id")
  jobPositionId   Int?         @map("job_position_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  employer      EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  industry      Industry?       @relation(fields: [industryId], references: [id])
  jobPosition   JobPosition?    @relation(fields: [jobPositionId], references: [id])
  locations     JobLocation[]
  applications  Application[]
  savedByUsers  SavedJob[]

  @@map("jobs")
}

model JobLocation {
  id           String  @id @default(uuid())
  jobId        String  @map("job_id")
  provinceCode String? @map("province_code")
  provinceName String? @map("province_name")
  districtCode String? @map("district_code")
  districtName String? @map("district_name")
  address      String?

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("job_locations")
}

model Resume {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   @default("resume")
  title       String   @default("CV chưa đặt tên")
  template    String   @default("tieu-chuan")
  color       String   @default("#00b14f")
  fontSize    String   @default("medium")
  lineSpacing Float    @default(1.5) @map("line_spacing")
  background  String   @default("white")
  content     Json
  fileUrl     String?  @map("file_url")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        Application[]
  defaultForCandidates CandidateProfile[] @relation("CandidateDefaultCv")

  @@map("resumes")
}

model Application {
  id              String            @id @default(uuid())
  jobId           String            @map("job_id")
  candidateId     String            @map("candidate_id")
  locationId      String?           @map("location_id")
  resumeId        String?           @map("resume_id")
  cvFileUrl       String?           @map("cv_file_url")
  coverLetter     String?           @map("cover_letter") @db.Text
  coverLetterId   String?           @map("cover_letter_id")
  status          ApplicationStatus @default(PENDING)
  note            String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        User         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  location         JobLocation? @relation(fields: [locationId], references: [id])
  resume           Resume?      @relation(fields: [resumeId], references: [id])
  coverLetterDoc   CoverLetter? @relation("ApplicationCoverLetter", fields: [coverLetterId], references: [id])

  @@unique([jobId, candidateId])
  @@map("applications")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model EmailTemplate {
  id         String            @id @default(uuid())
  employerId String            @map("employer_id")
  type       EmailTemplateType
  subject    String
  body       String            @db.Text
  isDefault  Boolean           @default(false) @map("is_default")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@map("email_templates")
}

model Payment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  gateway     String
  orderId     String   @unique @map("order_id")
  amount      Int
  plan        String
  status      String   @default("PENDING")
  gatewayData Json?    @map("gateway_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model CoverLetter {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @default("Cover Letter chưa đặt tên")
  templateId  String   @default("tinh-te-1") @map("template_id")
  color       String   @default("#1e3a5f")
  font        String   @default("Muli")
  fontSize    String   @default("medium") @map("font_size")
  lineSpacing Float    @default(1.5) @map("line_spacing")
  content     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[] @relation("ApplicationCoverLetter")

  @@map("cover_letters")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Conversation {
  id                String    @id @default(uuid())
  candidateId       String    @map("candidate_id")
  employerProfileId String    @map("employer_profile_id")
  lastMessageAt     DateTime? @map("last_message_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  candidate       User            @relation("CandidateConversations", fields: [candidateId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([candidateId, employerProfileId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  type           String   @default("text")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model EmployerCandidateConnect {
  id                String        @id @default(uuid())
  employerProfileId String        @map("employer_profile_id")
  candidateUserId   String        @map("candidate_user_id")
  status            ConnectStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  employer  EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  candidate User            @relation("ConnectCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([employerProfileId, candidateUserId])
  @@map("employer_candidate_connects")
}