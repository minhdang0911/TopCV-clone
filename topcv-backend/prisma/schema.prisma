generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobLevel {
  NHAN_VIEN
  TRUONG_NHOM
  TRUONG_PHO_PHONG
  QUAN_LY_GIAM_SAT
  TRUONG_CHI_NHANH
  PHO_GIAM_DOC
  GIAM_DOC
  THUC_TAP_SINH
}

enum WorkingType {
  TOAN_THOI_GIAN
  BAN_THOI_GIAN
  FREELANCE
  THUC_TAP
  REMOTE
}

enum WorkingDays {
  MON_FRI       // Thứ 2 - Thứ 6
  MON_SAT       // Thứ 2 - Thứ 7
  MON_SUN       // Thứ 2 - Chủ nhật
  FLEXIBLE      // Linh hoạt
  CUSTOM        // Tùy chỉnh (xem workingDaysNote)
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
}

enum EmailTemplateType {
  REJECTION
  INTERVIEW_INVITE
  OFFER_LETTER
}

enum ConnectStatus {
  PENDING
  CONNECTED
  REJECTED
  SKIPPED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  phone            String?  @unique
  role             Role     @default(CANDIDATE)
  isVerified       Boolean  @default(false) @map("is_verified")
  isActive         Boolean  @default(true) @map("is_active")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  provider         String   @default("local")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  plan             String    @default("FREE")
  planExpiresAt    DateTime? @map("plan_expires_at")
  resumes          Resume[]
  coverLetters     CoverLetter[]
  payments         Payment[]
  companyFollows   CompanyFollow[]
  companyReviews   CompanyReview[]
  employerReviews  EmployerReview[]
  applications     Application[]
  savedJobs        SavedJob[]
  fcmToken         String?   @map("fcm_token")

  conversationsAsCandidate Conversation[]             @relation("CandidateConversations")
  sentMessages             Message[]                   @relation("SentMessages")
  connectsAsCandidate      EmployerCandidateConnect[]  @relation("ConnectCandidate")
  jobAlerts                JobAlert[]
  feedbacks                Feedback[]
  meetingsAsCandidate      Meeting[]                   @relation("MeetingCandidate")
  ratingsGiven             Rating[]                    @relation("RatingsGiven")
  ratingsReceived          Rating[]                    @relation("RatingsReceived")
  quizzesAsEmployer        Quiz[]                      @relation("EmployerQuizzes")
  quizAttempts             QuizAttempt[]               @relation("CandidateAttempts")
  blogPosts                BlogPost[]
  blogBookmarks            BlogBookmark[]

  @@map("users")
}

model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  fullName            String   @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  isLookingForJob     Boolean  @default(false) @map("is_looking_for_job")
  allowEmployerSearch Boolean  @default(true) @map("allow_employer_search")
  jobPreferences      Json?    @map("job_preferences")
  defaultCvId         String?   @map("default_cv_id")
  gender              String?
  dob                 DateTime? @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCv Resume? @relation("CandidateDefaultCv", fields: [defaultCvId], references: [id], onDelete: SetNull)

  @@map("candidate_profiles")
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  logoUrl     String?  @map("logo_url")
  companySize String?  @map("company_size")
  industryId  Int?     @map("industry_id")
  industryIds Json?    @map("industry_ids")
  website     String?
  address     String?
  description String?
  taxCode     String?  @map("tax_code")
  slug        String?  @unique
  createdAt   DateTime @default(now()) @map("created_at")

  emailNotificationEnabled Boolean @default(false) @map("email_notification_enabled")

  phoneVerified          Boolean  @default(false) @map("phone_verified")
  businessDocType        String?  @map("business_doc_type")   // REGISTRATION | DELEGATION
  businessDocUrl         String?  @map("business_doc_url")    // ĐKKD hoặc Giấy ủy quyền
  businessDocUrl2        String?  @map("business_doc_url2")   // CCCD (chỉ khi DELEGATION)
  businessDocStatus      String?  @map("business_doc_status") // PENDING | APPROVED | REJECTED
  businessDocRejectReason String? @map("business_doc_reject_reason")

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry       Industry?                  @relation(fields: [industryId], references: [id])
  jobs           Job[]
  followers      CompanyFollow[]
  reviews        CompanyReview[]
  employerReviews EmployerReview[]
  emailTemplates EmailTemplate[]
  conversations  Conversation[]
  connects       EmployerCandidateConnect[]
  meetings       Meeting[]

  @@map("employer_profiles")
}

model CompanyFollow {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  employerProfileId String   @map("employer_profile_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, employerProfileId])
  @@map("company_follows")
}

model CompanyReview {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  employerProfileId String   @map("employer_profile_id")
  rating            Int
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, employerProfileId])
  @@map("company_reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployerReview {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  employerProfileId String       @map("employer_profile_id")

  title             String
  rating            Int
  overtimePolicy    String       @map("overtime_policy")  // satisfied | unsatisfied
  overtimeReason    String?      @map("overtime_reason")
  liked             String       @db.Text
  improvement       String       @db.Text
  salaryRating      Int          @map("salary_rating")
  trainingRating    Int          @map("training_rating")
  careRating        Int          @map("care_rating")
  cultureRating     Int          @map("culture_rating")
  officeRating      Int          @map("office_rating")
  recommend         Boolean
  status            ReviewStatus @default(PENDING)
  rejectReason      String?      @map("reject_reason")

  createdAt         DateTime     @default(now()) @map("created_at")

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@map("employer_reviews")
}

model Industry {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  employerProfiles EmployerProfile[]
  jobs             Job[]

  @@map("industries")
}

model JobPosition {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  jobs Job[]

  @@map("job_positions")
}

model Job {
  id              String       @id @default(uuid())
  employerId      String       @map("employer_id")
  title           String
  slug            String?      @unique @map("slug")
  description     String
  salaryMin       Int?         @map("salary_min")
  salaryMax       Int?         @map("salary_max")
  salaryType      String       @default("range") @map("salary_type")
  jobType         String?      @map("job_type")
  experience      String?
  level           JobLevel?
  workingType     WorkingType? @map("working_type")
  workingDays     WorkingDays? @map("working_days")
  workingDaysNote String?      @map("working_days_note")
  quantity        Int          @default(1)
  deadline        DateTime?
  isActive        Boolean      @default(true) @map("is_active")
  industryId      Int?         @map("industry_id")
  jobPositionId   Int?         @map("job_position_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  employer      EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  industry      Industry?       @relation(fields: [industryId], references: [id])
  jobPosition   JobPosition?    @relation(fields: [jobPositionId], references: [id])
  locations     JobLocation[]
  applications  Application[]
  savedByUsers  SavedJob[]

  @@map("jobs")
}

model JobLocation {
  id           String  @id @default(uuid())
  jobId        String  @map("job_id")
  provinceCode String? @map("province_code")
  provinceName String? @map("province_name")
  districtCode String? @map("district_code")
  districtName String? @map("district_name")
  address      String?

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("job_locations")
}

model Resume {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   @default("resume")
  title       String   @default("CV chưa đặt tên")
  template    String   @default("tieu-chuan")
  color       String   @default("#00b14f")
  fontSize    String   @default("medium")
  lineSpacing Float    @default(1.5) @map("line_spacing")
  background  String   @default("white")
  content     Json
  fileUrl     String?  @map("file_url")
  thumbnailUrl String? @map("thumbnail_url")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        Application[]
  defaultForCandidates CandidateProfile[] @relation("CandidateDefaultCv")

  @@map("resumes")
}

model Application {
  id              String            @id @default(uuid())
  jobId           String            @map("job_id")
  candidateId     String            @map("candidate_id")
  locationId      String?           @map("location_id")
  resumeId        String?           @map("resume_id")
  cvFileUrl       String?           @map("cv_file_url")
  coverLetter        String?           @map("cover_letter") @db.Text
  coverLetterId      String?           @map("cover_letter_id")
  coverLetterFileUrl String?           @map("cover_letter_file_url")
  status             ApplicationStatus @default(PENDING)
  note            String?           @db.Text
  interviewAt           DateTime? @map("interview_at")
  interviewLocation     String?   @map("interview_location")
  interviewType         String?   @map("interview_type")
  interviewReminderSent Boolean   @default(false) @map("interview_reminder_sent")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        User         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  location         JobLocation? @relation(fields: [locationId], references: [id])
  resume           Resume?      @relation(fields: [resumeId], references: [id])
  coverLetterDoc   CoverLetter? @relation("ApplicationCoverLetter", fields: [coverLetterId], references: [id])
  meetings         Meeting[]
  ratings          Rating[]
  quizAssignments  QuizAssignment[]

  @@unique([jobId, candidateId])
  @@map("applications")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model EmailTemplate {
  id         String            @id @default(uuid())
  employerId String            @map("employer_id")
  type       EmailTemplateType
  subject    String
  body       String            @db.Text
  isDefault  Boolean           @default(false) @map("is_default")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@map("email_templates")
}

model Payment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  gateway     String
  orderId     String   @unique @map("order_id")
  amount      Int
  plan        String
  status      String   @default("PENDING")
  gatewayData Json?    @map("gateway_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model CoverLetter {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @default("Cover Letter chưa đặt tên")
  templateId  String   @default("tinh-te-1") @map("template_id")
  color       String   @default("#1e3a5f")
  font        String   @default("Muli")
  fontSize    String   @default("medium") @map("font_size")
  lineSpacing Float    @default(1.5) @map("line_spacing")
  content     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[] @relation("ApplicationCoverLetter")

  @@map("cover_letters")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Conversation {
  id                String    @id @default(uuid())
  candidateId       String    @map("candidate_id")
  employerProfileId String    @map("employer_profile_id")
  lastMessageAt     DateTime? @map("last_message_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  candidate       User            @relation("CandidateConversations", fields: [candidateId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([candidateId, employerProfileId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  type           String   @default("text")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model EmployerCandidateConnect {
  id                String        @id @default(uuid())
  employerProfileId String        @map("employer_profile_id")
  candidateUserId   String        @map("candidate_user_id")
  status            ConnectStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  employer  EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  candidate User            @relation("ConnectCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([employerProfileId, candidateUserId])
  @@map("employer_candidate_connects")
}

model JobAlert {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  keyword       String
  provinceCode  String?   @map("province_code")
  districtCode  String?   @map("district_code")
  provinceName  String?   @map("province_name")
  districtName  String?   @map("district_name")
  salaryMin     Int?      @map("salary_min")
  salaryMax     Int?      @map("salary_max")
  experience    String?
  industryId    Int?      @map("industry_id")
  jobPositionId Int?      @map("job_position_id")
  workingType   String?   @map("working_type")
  frequency     String    @default("DAILY")
  channel       String    @default("BOTH")
  isActive      Boolean   @default(true) @map("is_active")
  lastSentAt    DateTime? @map("last_sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_alerts")
}
model Meeting {
  id             String    @id @default(cuid())
  roomCode       String    @unique @map("room_code")
  dailyRoomName  String    @unique @map("daily_room_name")
  applicationId  String?   @map("application_id")
  hostEmployerId String    @map("host_employer_id")
  candidateId    String    @map("candidate_id")
  title          String?
  scheduledAt    DateTime? @map("scheduled_at")
  status         String    @default("active")
  reminderSent   Boolean   @default(false) @map("reminder_sent")
  createdAt      DateTime  @default(now()) @map("created_at")

  hostEmployer EmployerProfile @relation(fields: [hostEmployerId], references: [id], onDelete: Cascade)
  candidate    User            @relation("MeetingCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  application  Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@map("meetings")
}

model Rating {
  id            String   @id @default(uuid())
  fromUserId    String   @map("from_user_id")
  toUserId      String   @map("to_user_id")
  applicationId String   @map("application_id")
  score         Int
  comment       String?
  type          String   // EMPLOYER_TO_CANDIDATE | CANDIDATE_TO_EMPLOYER
  createdAt     DateTime @default(now()) @map("created_at")

  fromUser    User        @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User        @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, applicationId, type])
  @@map("ratings")
}

model Feedback {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  topic       String
  description String
  rating      Int
  replyText   String?   @map("reply_text")
  repliedAt   DateTime? @map("replied_at")
  repliedBy   String?   @map("replied_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

enum ScoringMode {
  AUTO
  MANUAL
}

model Quiz {
  id               String      @id @default(cuid())
  employerId       String      @map("employer_id")
  title            String
  description      String?
  totalPoints      Float       @map("total_points")
  passRate         Float       @default(70) @map("pass_rate")
  durationMinutes  Int         @default(30) @map("duration_minutes")
  scoringMode      ScoringMode @default(AUTO) @map("scoring_mode")
  shuffleQuestions Boolean     @default(false) @map("shuffle_questions")
  shuffleOptions   Boolean     @default(false) @map("shuffle_options")
  rules            String?
  createdAt        DateTime    @default(now()) @map("created_at")

  employer    User             @relation("EmployerQuizzes", fields: [employerId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  assignments QuizAssignment[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String  @map("quiz_id")
  order         Int
  questionText  String? @map("question_text")
  imageUrl      String? @map("image_url")
  isCode        Boolean @default(false) @map("is_code")
  points        Float   @default(0)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers AttemptAnswer[]

  @@map("quiz_questions")
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  optionText String? @map("option_text")
  imageUrl   String? @map("image_url")
  isCorrect  Boolean @default(false) @map("is_correct")

  question QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@map("quiz_options")
}

model QuizAssignment {
  id            String    @id @default(cuid())
  quizId        String    @map("quiz_id")
  applicationId String    @map("application_id")
  sentAt        DateTime  @default(now()) @map("sent_at")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")

  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]

  @@unique([quizId, applicationId])
  @@map("quiz_assignments")
}

model QuizAttempt {
  id             String    @id @default(cuid())
  assignmentId   String    @map("assignment_id")
  candidateId    String    @map("candidate_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  submittedAt    DateTime? @map("submitted_at")
  score          Float?
  passed         Boolean?
  questionOrder  Json?     @map("question_order")
  optionOrders   Json?     @map("option_orders")

  assignment QuizAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  candidate  User           @relation("CandidateAttempts", fields: [candidateId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@map("quiz_attempts")
}

model AttemptAnswer {
  id               String @id @default(cuid())
  attemptId        String @map("attempt_id")
  questionId       String @map("question_id")
  selectedOptionId String @map("selected_option_id")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model BlogCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  coverImage  String? @map("cover_image")

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id          String    @id @default(cuid())
  authorId    String    @map("author_id")
  categoryId  String    @map("category_id")
  title       String
  slug        String    @unique
  description String?
  content     String    @db.Text
  thumbnail   String?
  minRead     Int       @default(1) @map("min_read")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  viewCount   Int       @default(0) @map("view_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags      BlogPostTag[]
  bookmarks BlogBookmark[]

  @@map("blog_posts")
}

model BlogTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogBookmark {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("blog_bookmarks")
}
