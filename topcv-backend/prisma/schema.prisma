generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobLevel {
  NHAN_VIEN
  TRUONG_NHOM
  TRUONG_PHO_PHONG
  QUAN_LY_GIAM_SAT
  TRUONG_CHI_NHANH
  PHO_GIAM_DOC
  GIAM_DOC
  THUC_TAP_SINH
}

enum WorkingType {
  TOAN_THOI_GIAN
  BAN_THOI_GIAN
  FREELANCE
  THUC_TAP
  REMOTE
}

enum WorkingDays {
  MON_FRI       // Thứ 2 - Thứ 6
  MON_SAT       // Thứ 2 - Thứ 7
  MON_SUN       // Thứ 2 - Chủ nhật
  FLEXIBLE      // Linh hoạt
  CUSTOM        // Tùy chỉnh (xem workingDaysNote)
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  phone            String?  @unique
  role             Role     @default(CANDIDATE)
  isVerified       Boolean  @default(false) @map("is_verified")
  isActive         Boolean  @default(true) @map("is_active")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  provider         String   @default("local")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  resumes          Resume[]
  companyFollows   CompanyFollow[]
  companyReviews   CompanyReview[]

  @@map("users")
}

model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  fullName            String   @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  isLookingForJob     Boolean  @default(true) @map("is_looking_for_job")
  allowEmployerSearch Boolean  @default(true) @map("allow_employer_search")
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  logoUrl     String?  @map("logo_url")
  companySize String?  @map("company_size")
  industryId  Int?     @map("industry_id")
  website     String?
  address     String?
  description String?
  taxCode     String?  @map("tax_code")
  slug        String?  @unique
  createdAt   DateTime @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry  Industry?        @relation(fields: [industryId], references: [id])
  jobs      Job[]
  followers CompanyFollow[]
  reviews   CompanyReview[]

  @@map("employer_profiles")
}

model CompanyFollow {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  employerProfileId String   @map("employer_profile_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, employerProfileId])
  @@map("company_follows")
}

model CompanyReview {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  employerProfileId String   @map("employer_profile_id")
  rating            Int
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, employerProfileId])
  @@map("company_reviews")
}

model Industry {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  employerProfiles EmployerProfile[]
  jobs             Job[]

  @@map("industries")
}

model JobPosition {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  jobs Job[]

  @@map("job_positions")
}

model Job {
  id               String       @id @default(uuid())
  employerId       String       @map("employer_id")
  title            String
  description      String
  salaryMin        Int?         @map("salary_min")
  salaryMax        Int?         @map("salary_max")
  salaryType       String       @default("range") @map("salary_type")
  address          String?
  provinceCode     String?      @map("province_code")
  provinceName     String?      @map("province_name")
  districtCode     String?      @map("district_code")
  districtName     String?      @map("district_name")
  jobType          String?      @map("job_type")
  experience       String?
  level            JobLevel?
  workingType      WorkingType? @map("working_type")
  workingDays      WorkingDays? @map("working_days")
  workingDaysNote  String?      @map("working_days_note")
  quantity         Int          @default(1)
  deadline         DateTime?
  isActive         Boolean      @default(true) @map("is_active")
  industryId       Int?         @map("industry_id")
  jobPositionId    Int?         @map("job_position_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  employer    EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  industry    Industry?       @relation(fields: [industryId], references: [id])
  jobPosition JobPosition?    @relation(fields: [jobPositionId], references: [id])

  @@map("jobs")
}

model Resume {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @default("CV chưa đặt tên")
  template    String   @default("default_v2")
  color       String   @default("#00b14f")
  fontSize    String   @default("medium")
  lineSpacing Float    @default(1.5) @map("line_spacing")
  background  String   @default("white")
  content     Json
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}